{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "max_output_tokens": {
      "default": 4000,
      "type": "integer",
      "minimum": 256,
      "maximum": 8000
    },
    "change_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "from": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "to": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "component": {
      "default": "summary",
      "type": "string",
      "enum": [
        "summary",
        "before",
        "after",
        "evidence",
        "coverage_gaps",
        "coverage_features",
        "lineage_reasons",
        "topology"
      ]
    },
    "component_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "text_offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "text_length": {
      "default": 256,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "project_id",
    "report_id",
    "change_id"
  ],
  "additionalProperties": false
}
