{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "max_output_tokens": {
      "default": 4000,
      "type": "integer",
      "minimum": 256,
      "maximum": 8000
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "text_offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "text_length": {
      "default": 500,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "span_offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "span_limit": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "appearance_evidence_offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "appearance_evidence_limit": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "ocr_empty_character_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "ocr_context_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "ocr_observation_index": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "ocr_token_offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "ocr_token_limit": {
      "default": 4,
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "ocr_alternative_index": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "ocr_alternative_offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ocr_alternative_length": {
      "default": 256,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "project_id",
    "report_id",
    "observation_id"
  ],
  "additionalProperties": false
}
