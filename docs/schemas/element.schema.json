{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "table_cell",
        "image",
        "shape",
        "unsupported"
      ]
    },
    "text": {
      "type": "string"
    },
    "normalized_text": {
      "type": "string"
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "reading_order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "unsupported",
        "extraction_failed"
      ]
    },
    "method": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "observed",
        "inferred"
      ]
    },
    "ocr": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_scope": {
          "type": "string",
          "const": "line"
        },
        "numeric_consensus": {
          "type": "boolean"
        },
        "ambiguous": {
          "type": "boolean"
        },
        "alternatives": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "text",
              "confidence",
              "truncated"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "confidence",
        "confidence_scope",
        "numeric_consensus",
        "ambiguous",
        "alternatives"
      ],
      "additionalProperties": false
    },
    "media_hash": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "visible",
        "occluded",
        "partially_occluded",
        "struck_through",
        "struck_inferred",
        "partially_struck_through",
        "hidden_render_mode",
        "uncertain",
        "unverified"
      ]
    },
    "visibility_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "paint_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "assessment": {
            "type": "string",
            "enum": [
              "observed",
              "inferred"
            ]
          }
        },
        "required": [
          "text",
          "state",
          "bbox",
          "paint_index",
          "assessment"
        ],
        "additionalProperties": false
      }
    },
    "visibility_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "assessment": {
            "type": "string",
            "enum": [
              "observed",
              "inferred"
            ]
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "method",
          "bbox",
          "assessment",
          "coverage"
        ],
        "additionalProperties": false
      }
    },
    "table": {
      "type": "object",
      "properties": {
        "table_id": {
          "type": "string"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "row_span": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "column_span": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "origin": {
          "type": "string",
          "enum": [
            "ooxml_table",
            "pdf_grid_inferred",
            "vision_table_inferred"
          ]
        },
        "assessment": {
          "type": "string",
          "enum": [
            "observed",
            "inferred"
          ]
        }
      },
      "required": [
        "table_id",
        "row",
        "column",
        "origin",
        "assessment"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "observation_id",
    "kind",
    "text",
    "normalized_text",
    "bbox",
    "reading_order",
    "availability",
    "method",
    "source_ref",
    "provenance"
  ],
  "additionalProperties": false
}
