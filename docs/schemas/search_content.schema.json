{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "max_output_tokens": {
      "default": 4000,
      "type": "integer",
      "minimum": 256,
      "maximum": 8000
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "format": {
      "type": "string",
      "enum": [
        "pptx",
        "pdf"
      ]
    },
    "section": {
      "default": "comparison",
      "type": "string",
      "enum": [
        "comparison",
        "source",
        "visible",
        "unresolved",
        "suppressed",
        "ocr",
        "ocr_unresolved",
        "notes"
      ]
    },
    "case_sensitive": {
      "default": true,
      "type": "boolean"
    },
    "text_length": {
      "default": 256,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "project_id",
    "report_id",
    "text"
  ],
  "additionalProperties": false
}
