{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "max_output_tokens": {
      "default": 4000,
      "type": "integer",
      "minimum": 256,
      "maximum": 8000
    }
  },
  "required": [
    "project_id"
  ],
  "additionalProperties": false
}
