{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "title": {
      "type": "string"
    },
    "revisions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "files": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "label",
          "files"
        ]
      }
    },
    "mapping_decisions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_page_id": {
            "type": "string"
          },
          "to_page_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "link",
              "unlink"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from_page_id",
          "to_page_id",
          "action",
          "reason"
        ]
      }
    },
    "mapping_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "continuation",
              "split",
              "merge"
            ]
          },
          "from_occurrence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "to_occurrence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "from_page_ids": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "to_page_ids": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "kind",
          "from_occurrence",
          "to_occurrence",
          "from_page_ids",
          "to_page_ids",
          "reason"
        ]
      }
    }
  },
  "required": [
    "project_id",
    "title",
    "revisions"
  ]
}
