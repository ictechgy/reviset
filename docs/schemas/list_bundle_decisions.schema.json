{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "max_output_tokens": {
      "default": 4000,
      "type": "integer",
      "minimum": 256,
      "maximum": 8000
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "source_page_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,160}$"
    },
    "reason_offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason_length": {
      "default": 120,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "project_id",
    "report_id"
  ],
  "additionalProperties": false
}
